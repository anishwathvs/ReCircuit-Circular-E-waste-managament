# ========================================================
# RECIRCUIT — PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=https://recircuit.in
CORS_ORIGIN=https://recircuit.in,http://localhost:5173

# PostgreSQL Database (Neon Lakebase Postgres / Prisma ORM)
# Runtime pooled connection (for Render backend web service)
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct unpooled connection (for migrations and schema sync)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication & Refresh Token Rotation
JWT_SECRET="generate-with-openssl-rand-base64-64"
JWT_REFRESH_SECRET="generate-with-openssl-rand-base64-64"
ALLOW_DEMO_LOGIN=false

# Cloudinary Secure Image Storage (Optional: Falls back to local /uploads if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email (Nodemailer / SendGrid / AWS SES / Ethereal)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_ses_smtp_key
SMTP_FROM="ReCircuit E-Waste Platform <notifications@recircuit.in>"

# Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_here
RAZORPAY_KEY_SECRET=your_actual_secret_here
PAYMENT_WEBHOOK_SECRET=your_hmac_webhook_secret_2026

# Google Maps Platform (Optional: Built-in Chennai operational mapping active by default)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

